# ── BLE (NimBLE) ──────────────────────────────────────────────────────────────
CONFIG_BT_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y

# ── Память / стек ───────────────────────────────────────────────────────────────
# BLE + std требуют запас стека главной задачи.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12000

# ── Флеш и таблица разделов ─────────────────────────────────────────────────────
# Образ с BLE крупный (~1.3 МБ), поэтому своя таблица разделов с большим
# app-разделом (см. partitions.csv). Под флеш 4 МБ.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ── RTC / тактирование сна ──────────────────────────────────────────────────────
# Источник RTC_SLOW по умолчанию — внутренний RC-осциллятор (~136 кГц). От него
# зависит И длительность deep sleep (esp_sleep_enable_timer_wakeup), И системные
# часы, доживающие сквозь сон. RC некалиброван и плывёт с температурой/питанием,
# поэтому время суток и интервалы дрейфуют (особенно за долгий ночной сон).
# Увеличиваем число калибровочных циклов RC против основного XTAL при старте —
# это уточняет пересчёт «микросекунды↔тики» и убирает постоянную составляющую
# ошибки. ВАЖНО: температурный дрейф так не лечится — для реальной точности нужен
# внешний кварц 32.768 кГц (CONFIG_RTC_CLK_SRC_EXT_CRYS), которого на плате нет.
# Поэтому телефон должен периодически пере-синхронизировать время (характеристика
# CHAR_TIME в режиме настройки).
CONFIG_RTC_CLK_CAL_CYCLES=8192

# ── Power management (для фичи light_sleep) ───────────────────────────────────────
# Раскомментируйте обе строки, если собираете с `--features light_sleep`: CPU
# будет дремать между событиями, а BLE-контроллер продолжит поддерживать рекламу
# (modem sleep). Без них enable_light_sleep() вернёт ошибку и устройство просто
# останется полностью бодрствующим. По умолчанию ВЫКЛ — при отладке нужен
# непрерывный лог.
# CONFIG_PM_ENABLE=y
# CONFIG_FREERTOS_USE_TICKLESS_IDLE=y

# ── Brownout ────────────────────────────────────────────────────────────────────
# Порог пониже, чтобы пусковой ток мотора и просадка LiPo под конец разряда не
# вызывали ложный сброс. C_bulk на VBAT — основная защита, это страховка.
CONFIG_ESP_BROWNOUT_DET_LVL_SEL_4=y
